{
  "uid": "chaos-postgres",
  "title": "2. PostgreSQL",
  "description": "Saude e carga do Postgres, via postgres-exporter, cruzada com a visao da aplicacao (dependency_up).",
  "tags": ["chaos-lab", "banco"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "Alertas disparados",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "enable": true,
        "iconColor": "red",
        "expr": "ALERTS{alertstate=\"firing\"}",
        "titleFormat": "{{alertname}}"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "db",
        "label": "Database",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(pg_database_size_bytes, datname)", "refId": "A" },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Disponibilidade",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Postgres up",
      "description": "pg_up: o exporter conseguiu conectar.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FORA", "color": "red", "index": 0 }, "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "pg_up" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Visao da aplicacao",
      "description": "dependency_up{dependency=\"postgres\"} - o que o /health da API enxerga. Divergir de pg_up indica problema de rede/credencial da app, nao do banco.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "FORA", "color": "red", "index": 0 }, "1": { "text": "OK", "color": "green", "index": 1 } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "graphMode": "none", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "dependency_up{dependency=\"postgres\"}" }]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Uso de conexoes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "100 * sum(pg_stat_database_numbackends) / max(pg_settings_max_connections)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Conexoes ativas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(pg_stat_database_numbackends)" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "Abaixo de 99% em carga estavel costuma indicar shared_buffers pequeno ou varredura sequencial.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 4,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "graphMode": "area", "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pg_stat_database_blks_hit{datname=~\"$db\"}[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit{datname=~\"$db\"}[$__rate_interval])) + sum(rate(pg_stat_database_blks_read{datname=~\"$db\"}[$__rate_interval])), 0.0001)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Tamanho do banco",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 1 }, "overrides": [] },
      "options": { "graphMode": "area", "colorMode": "value", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "refId": "A", "expr": "sum(pg_database_size_bytes{datname=~\"$db\"})" }]
    },
    {
      "type": "row",
      "title": "Transacoes e carga",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Transacoes por segundo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [
        { "matcher": { "id": "byRegexp", "options": "rollback.*" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
      ] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (datname) (rate(pg_stat_database_xact_commit{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "commit {{datname}}" },
        { "refId": "B", "expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "rollback {{datname}}" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Operacoes em tuplas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true, "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_tup_inserted{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "inseridas" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_tup_updated{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "atualizadas" },
        { "refId": "C", "expr": "sum(rate(pg_stat_database_tup_deleted{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "deletadas" },
        { "refId": "D", "expr": "sum(rate(pg_stat_database_tup_fetched{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "lidas (fetched)" },
        { "refId": "E", "expr": "sum(rate(pg_stat_database_tup_returned{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "varridas (returned)" }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Conexoes por banco",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" }, "thresholdsStyle": { "mode": "line" } },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "red", "value": 100 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "pg_stat_database_numbackends{datname=~\"$db\"}", "legendFormat": "{{datname}}" },
        { "refId": "B", "expr": "max(pg_settings_max_connections)", "legendFormat": "max_connections" }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Locks por modo",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum by (mode) (pg_locks_count{datname=~\"$db\"}) > 0", "legendFormat": "{{mode}}" }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Deadlocks e conflitos",
      "description": "Qualquer valor acima de zero merece investigacao.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 14 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1 }, "color": { "mode": "fixed", "fixedColor": "red" } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(pg_stat_database_deadlocks{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "deadlocks" },
        { "refId": "B", "expr": "sum(rate(pg_stat_database_conflicts{datname=~\"$db\"}[$__rate_interval]))", "legendFormat": "conflitos" }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Transacao aberta mais longa",
      "description": "Transacao idle in transaction segurando XID e o caminho classico para bloat e wraparound.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max by (state) (pg_stat_activity_max_tx_duration{datname=~\"$db\", state=~\"active|idle in transaction\"})", "legendFormat": "{{state}}" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Crescimento do banco",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 2 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "pg_database_size_bytes{datname=~\"$db\"}", "legendFormat": "{{datname}}" }
      ]
    },
    {
      "type": "row",
      "title": "Logs do Postgres",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "panels": []
    },
    {
      "id": 20,
      "type": "logs",
      "title": "Logs do container postgres",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 30 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [{ "refId": "A", "expr": "{service=\"postgres\"}" }]
    }
  ]
}
